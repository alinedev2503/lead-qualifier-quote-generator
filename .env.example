# Gemini (server-side only — never expose in the browser)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Active client folder: clients/<slug>/
LEAD_CLIENT="demo"

# Lead destination: local | sheets | webhook
LEAD_SINK="local"

# Required when LEAD_SINK=sheets
SHEET_ID="MY_GOOGLE_SHEET_ID"
GOOGLE_SERVICE_ACCOUNT="./credentials/service-account.json"

# Required for the dashboard and lead inbox in production
ADMIN_TOKEN="MY_ADMIN_TOKEN"

# Optional e-mail alert (Standard and Advanced)
ALERT_EMAIL_TO="owner@example.com"

# Host URL (used to build the embed widget URL)
APP_URL="http://localhost:3000"

# Gemini — optional. Without a key the app still works with deterministic explanations.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# Active client folder under clients/<slug>/
LEAD_CLIENT="demo-landscaping"

# local | sheets
LEAD_SINK="local"

# Required only when LEAD_SINK=sheets
SHEET_ID=""
GOOGLE_SERVICE_ACCOUNT="./credentials/service-account.json"

# Protects /api/leads in production. Leave empty for local demos.
ADMIN_TOKEN=""

# Canonical URL shown in the embed snippet. Falls back to the browser origin.
PUBLIC_ORIGIN=""

PORT=3000
